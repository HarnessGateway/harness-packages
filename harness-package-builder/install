#!/bin/sh
# Installs Claude Code at a pinned version under $HG_HARNESS/tools, by its makers' documented method (npm).
set -eu
VERSION=2.1.323

for need in node npm python3; do
  command -v "$need" >/dev/null 2>&1 || {
    echo "this image has no $need: Claude Code needs Node.js 22 or later, and this package's run needs python3" >&2
    exit 1
  }
done

# npm 12 runs no package's install script unless told to, and earlier npm runs every one. Claude Code needs its
# own, which puts the native binary for this machine in place, so it runs here by name, and no other does.
npm install --prefix "$HG_HARNESS/tools" --no-audit --no-fund --loglevel=error --ignore-scripts \
  "@anthropic-ai/claude-code@$VERSION"
node "$HG_HARNESS/tools/node_modules/@anthropic-ai/claude-code/install.cjs"

got=$("$HG_HARNESS/tools/node_modules/.bin/claude" --version | awk '{print $1}')
[ "$got" = "$VERSION" ] || { echo "installed Claude Code $got, wanted $VERSION" >&2; exit 1; }
echo "Claude Code $got installed"

# The builder checks the packages it writes with the platform's own checker (`harnessgateway package check`):
# the platform that runs this install, which it puts beside the kit as a wheel. Never a version chosen here, or
# the builder would be told one contract and check against another. It gets a Python environment of its own.
wheel=$(ls "$HG_HARNESS"/kit/harnessgateway-*.whl 2>/dev/null | head -n 1)
[ -n "$wheel" ] || {
  echo "this platform put no wheel of itself in $HG_HARNESS/kit: the builder needs HarnessGateway 4.3 or later" >&2
  exit 1
}
python3 -c 'import sys; sys.exit(sys.version_info < (3, 12))' || {
  echo "this image's python3 is older than 3.12, which the platform's package checker needs" >&2
  exit 1
}
python3 -m venv "$HG_HARNESS/tools/platform"
"$HG_HARNESS/tools/platform/bin/pip" install --quiet --disable-pip-version-check "$wheel"
echo "the package checker of HarnessGateway $("$HG_HARNESS/tools/platform/bin/harnessgateway" version) installed"
