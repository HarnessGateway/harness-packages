#!/bin/sh
# Installs the OpenHands Software Agent SDK at a pinned version under $HG_HARNESS/tools, by its makers'
# documented method (PyPI, in a virtual environment of its own).
set -eu
VERSION=1.62.0

command -v python3 >/dev/null 2>&1 || {
  echo "this image has no python3: the OpenHands Software Agent SDK needs Python 3.12 or later" >&2
  exit 1
}

if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 12))'; then
  echo "this image's python3 is $(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); the OpenHands Software Agent SDK needs Python 3.12 or later" >&2
  exit 1
fi

python3 -c 'import ensurepip, venv' >/dev/null 2>&1 || {
  echo "this image's python3 has no venv/ensurepip: the installer needs them to install the SDK under \$HG_HARNESS/tools" >&2
  exit 1
}

VENV="$HG_HARNESS/tools/venv"
python3 -m venv "$VENV"
"$VENV/bin/python" -m pip install --quiet --disable-pip-version-check --no-cache-dir \
  "openhands-sdk==$VERSION" "openhands-tools==$VERSION"

OPENHANDS_SUPPRESS_BANNER=1 LITELLM_LOCAL_MODEL_COST_MAP=True \
  "$VENV/bin/python" - "$VERSION" <<'PY'
import importlib.metadata
import sys

wanted = sys.argv[1]
for distribution in ("openhands-sdk", "openhands-tools"):
    got = importlib.metadata.version(distribution)
    if got != wanted:
        raise SystemExit(f"installed {distribution} {got}, wanted {wanted}")

from openhands.sdk import LLM, Agent, Conversation  # noqa: F401
from openhands.tools.preset.default import get_default_agent

agent = get_default_agent(llm=LLM(model="anthropic/placeholder"), cli_mode=True)
names = sorted(tool.name for tool in agent.tools)
if names != ["file_editor", "task_tracker", "terminal"]:
    raise SystemExit(f"the SDK's default CLI tools are {names}, not the expected three")
print(f"OpenHands Software Agent SDK {wanted} installed with tools: {', '.join(names)}")
PY
