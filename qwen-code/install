#!/bin/sh
# Installs Qwen Code at a pinned version under $HG_HARNESS/tools, by its makers' documented method (npm).
set -eu
VERSION=0.28.0

for need in node npm python3; do
  command -v "$need" >/dev/null 2>&1 || {
    echo "this image has no $need: Qwen Code needs Node.js 22 or later, and this package's run needs python3" >&2
    exit 1
  }
done

node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' || {
  echo "this image's node is $(node --version); Qwen Code needs Node.js 22 or later" >&2
  exit 1
}

# The package declares no install scripts. --ignore-scripts makes npm 12 (which runs none by default) and
# earlier npm (which runs every one) install the same tree; its platform binaries are optional dependencies.
npm install --prefix "$HG_HARNESS/tools" --no-audit --no-fund --loglevel=error --ignore-scripts \
  "@qwen-code/qwen-code@$VERSION"

got=$("$HG_HARNESS/tools/node_modules/.bin/qwen" --version | awk '{print $1}')
[ "$got" = "$VERSION" ] || { echo "installed Qwen Code $got, wanted $VERSION" >&2; exit 1; }
echo "Qwen Code $got installed"
