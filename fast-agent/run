#!/usr/bin/env python3
"""One turn of fast-agent, headless: run it over the Agent Client Protocol and say in Responses events what it does.

fast-agent has no JSON-lines one-shot mode. Its makers' machine-readable surface is the ACP stdio server
(`fast-agent acp`): JSON-RPC 2.0, one object per line on stdout, with `session/update` notifications while the
agent works and one answer to `session/prompt`. This file speaks that protocol as a minimal ACP client.
"""

import json
import os
import re
import signal
import subprocess
import sys
import threading

sys.path.insert(0, os.path.join(os.environ["HG_HARNESS"], "kit"))

import hgkit  # noqa: E402 - the kit is found through the path set above

DIFF_MAX = 100_000
# The provider API this turn speaks, as fast-agent names the provider in a model spec and a config section.
PROVIDERS = {
    "anthropic": "anthropic",
    "openai-chat": "openai",
    "openai-responses": "responses",
    "gemini": "google",
}
STATUS_LINE = re.compile(r"([\d,]+)\s+in,\s*([\d,]+)\s+out")
EXIT_CODE = re.compile(r"\n\n?\[Exit code: (-?\d+)\]\s*$")


class Stop(Exception):
    """The platform stopped the turn."""


class Acp:
    """The CLI as an ACP stdio peer: its standard output, a line at a time, and a way to answer it.

    Under `HG_REPLAY` the recorded standard output is read instead and nothing is sent: the same reaction to
    the same lines, so a turn's translation can be checked without the CLI or a model.
    """

    def __init__(self, command, env, cwd, record=None, replay=None):
        self.command = command
        self.env = env
        self.cwd = cwd
        self.record = record
        self.replay = replay
        self.process = None
        self._writing = threading.Lock()

    def start(self):
        if self.replay:
            return
        self.process = subprocess.Popen(  # noqa: S603 - the command is this package's own
            self.command, env=self.env, cwd=self.cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            text=True, encoding="utf-8", errors="replace", bufsize=1, start_new_session=True,
        )

    def send(self, message):
        if self.process is None or self.process.stdin is None:
            return
        with self._writing:
            try:
                self.process.stdin.write(json.dumps(message) + "\n")
                self.process.stdin.flush()
            except (BrokenPipeError, ValueError):
                pass

    def lines(self):
        if self.replay:
            with open(self.replay, encoding="utf-8") as file:
                for line in file:
                    yield line.rstrip("\n")
            return
        assert self.process is not None and self.process.stdout is not None
        recording = open(self.record, "a", encoding="utf-8") if self.record else None
        try:
            for line in self.process.stdout:
                if recording is not None:
                    recording.write(line)
                    recording.flush()
                yield line.rstrip("\n")
        finally:
            if recording is not None:
                recording.close()

    def stop(self, grace=5.0):
        """End the CLI and everything it started; a new session is its own process group."""
        if self.process is None or self.process.poll() is not None:
            return
        try:
            os.killpg(self.process.pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            return
        try:
            self.process.wait(timeout=grace)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(self.process.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            try:
                self.process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass


class Terminals:
    """The terminal/* methods an ACP client offers. fast-agent runs its shell tool through them when the
    client advertises `terminal`, which is how a turn sees the command and its output."""

    def __init__(self):
        self._items = {}
        self._lock = threading.Lock()
        self._next = 0

    def create(self, params):
        with self._lock:
            self._next += 1
            identifier = f"term-{self._next}"
            self._items[identifier] = self._start(identifier, params)
        return identifier

    def _start(self, identifier, params):
        argv = [str(params.get("command", ""))] + [str(arg) for arg in params.get("args") or []]
        environment = dict(os.environ)
        for item in params.get("env") or []:
            if isinstance(item, dict) and "name" in item:
                environment[str(item["name"])] = str(item.get("value", ""))
        cwd = params.get("cwd") or os.environ.get("HG_WORK") or None
        limit = int(params.get("outputByteLimit") or 1_000_000)
        try:
            process = subprocess.Popen(  # noqa: S603 - the agent's own command, as ACP intends
                argv, env=environment, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, encoding="utf-8", errors="replace", bufsize=1, start_new_session=True,
            )
        except OSError as error:
            empty = threading.Thread(target=lambda: None)
            empty.start()
            return {"error": error, "output": f"{error}\n", "process": None, "limit": limit,
                    "ident": identifier, "lock": threading.Lock(), "reader": empty}
        record = {"error": None, "output": "", "process": process, "limit": limit, "ident": identifier,
                  "lock": threading.Lock()}

        def read():
            assert process.stdout is not None
            for line in process.stdout:
                with record["lock"]:
                    record["output"] = (record["output"] + line)[-limit:]

        record["reader"] = threading.Thread(target=read, daemon=True)
        record["reader"].start()
        return record

    def get(self, identifier):
        with self._lock:
            return self._items.get(identifier)

    def wait(self, identifier):
        record = self.get(identifier)
        if record is None:
            return {"exitCode": None, "signal": "not found"}
        process = record["process"]
        if process is None:
            return {"exitCode": 1, "signal": None}
        code = process.wait()
        record["reader"].join(timeout=2)
        if code < 0:
            return {"exitCode": None, "signal": signal.Signals(-code).name}
        return {"exitCode": code, "signal": None}

    def output(self, identifier):
        record = self.get(identifier)
        if record is None:
            return {"output": "", "truncated": False, "exitStatus": None}
        process = record["process"]
        with record["lock"]:
            text = record["output"]
        status = None
        if process is not None and process.poll() is not None:
            code = process.returncode
            status = {"exitCode": code if code >= 0 else None,
                      "signal": signal.Signals(-code).name if code < 0 else None}
        return {"output": text, "truncated": len(text) >= record["limit"], "exitStatus": status}

    def kill(self, identifier):
        record = self.get(identifier)
        process = record["process"] if record else None
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass

    def release(self, identifier):
        self.kill(identifier)
        with self._lock:
            self._items.pop(identifier, None)

    def stop_all(self):
        for identifier in list(self._items):
            self.release(identifier)


def write_config(request):
    """The provider, endpoint, key placeholder and model, as a fast-agent config file for this turn."""
    api = os.environ.get("HG_PROVIDER_API", "")
    provider = PROVIDERS.get(api)
    if provider is None:
        raise ValueError(f"this package speaks anthropic, openai-chat, openai-responses and gemini, not {api!r}")
    model = os.environ.get("HG_MODEL", "")
    if not model:
        raise ValueError("the request named no model")
    spec = f"{provider}.{model}"
    if request.effort:
        spec += f"?reasoning={request.effort}"
    lines = [
        f"default_model: {json.dumps(spec)}",
        f"{provider}:",
        '  api_key: "${HG_PROVIDER_KEY}"',
        f"  base_url: {json.dumps(os.environ.get('HG_PROVIDER_URL', ''))}",
        "logger:",
        "  type: none",
    ]
    folder = os.environ["HG_STATE"]
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, "fast-agent.yaml")
    with open(path, "w", encoding="utf-8") as file:
        file.write("\n".join(lines) + "\n")
    return path, spec


def write_instructions(request):
    """The request's instructions as the CLI's instruction file; None when the request has none."""
    if not request.instructions:
        return None
    path = os.path.join(os.environ["HG_STATE"], "instructions.md")
    with open(path, "w", encoding="utf-8") as file:
        file.write(request.instructions)
    return path


def mcp_servers(request):
    """The request's remote MCP servers, as ACP HTTP servers."""
    found = []
    for server in request.mcp_servers:
        label, url = server.get("server_label"), server.get("server_url")
        if not label or not url:
            continue
        headers = [{"name": name, "value": str(value)}
                   for name, value in (server.get("headers") or {}).items()]
        found.append({"type": "http", "name": str(label), "url": str(url), "headers": headers})
    return found


def command(model_spec, config_path, instructions_path):
    args = [os.path.join(os.environ["HG_HARNESS"], "tools", "venv", "bin", "fast-agent"),
            "--no-update-check", "acp",
            "-c", config_path,
            "--home", os.path.join(os.environ["HG_MIND"], ".fast-agent"),
            "--model", model_spec,
            "-x", "--no-permissions"]
    if instructions_path:
        args += ["-i", instructions_path]
    return args


def lines_of(text, mark):
    return "".join(f"{mark}{line}\n" for line in text.splitlines())[:DIFF_MAX]


def content_text(content):
    """A tool call result's text, from ACP content blocks."""
    parts = []
    for block in content or []:
        if not isinstance(block, dict):
            continue
        inner = block.get("content")
        if isinstance(inner, dict) and inner.get("type") == "text":
            parts.append(inner.get("text", ""))
        elif block.get("type") == "text":
            parts.append(block.get("text", ""))
    return "\n".join(part for part in parts if part)


def status_usage(meta):
    """The token counts fast-agent puts in the status line it attaches to an ACP update or prompt answer."""
    if not isinstance(meta, dict):
        return None
    metrics = meta.get("field_meta", meta).get("openhands.dev/metrics", {})
    line = metrics.get("status_line") if isinstance(metrics, dict) else None
    if not isinstance(line, str):
        return None
    match = STATUS_LINE.search(line)
    if not match:
        return None
    return {"input_tokens": int(match.group(1).replace(",", "")),
            "output_tokens": int(match.group(2).replace(",", ""))}


class Translator:
    """fast-agent's ACP lines in, Responses events out."""

    def __init__(self, emit):
        self.emit = emit
        self.active = False               # ignore the replay of an earlier conversation while resuming
        self.calls = {}                   # toolCallId -> what is known about it
        self.order = []                   # toolCallId, in the order the calls began
        self.usage = None
        self.text = False
        self.ended = False

    def update(self, update, meta=None):
        if not self.active:
            return
        counted = status_usage(meta)
        if counted:
            self.usage = counted
        kind = update.get("sessionUpdate")
        if kind == "agent_message_chunk":
            text = (update.get("content") or {}).get("text", "")
            if text:
                self.flush_unargued()     # a tool the protocol never described came before this text
                self.text = True
                self.emit.say(text)
        elif kind == "agent_thought_chunk":
            text = (update.get("content") or {}).get("text", "")
            if text:
                self.emit.think(text)
        elif kind in ("tool_call", "tool_call_update"):
            self.tool(update)

    def tool(self, update):
        identifier = update.get("toolCallId")
        if not identifier:
            return
        call = self.calls.setdefault(identifier, {"status": None, "output": None})
        if identifier not in self.order:
            self.order.append(identifier)
        for field in ("title", "kind", "status", "rawInput", "rawOutput", "content"):
            if update.get(field) is not None:
                call[field] = update[field]
        if update.get("content"):
            text = content_text(update["content"])
            if text:
                call["output"] = text
        if update.get("rawOutput") is not None:
            call["output"] = update["rawOutput"]
        if call.get("status") in ("completed", "failed") and not call.get("emitted"):
            self.emit_tool(call)

    def flush_unargued(self):
        """A tool call the protocol disclosed only as a name (fast-agent's local `Shell` is one): report it
        before the text that follows it, with the arguments it did not disclose."""
        for identifier in self.order:
            call = self.calls.get(identifier)
            if call and not call.get("emitted") and call.get("rawInput") is None:
                self.emit_tool(call)

    def finish_tools(self):
        for identifier in self.order:
            call = self.calls.get(identifier)
            if call and not call.get("emitted"):
                self.emit_tool(call)

    def emit_tool(self, call):
        call["emitted"] = True
        title = str(call.get("title") or "tool")
        kind = call.get("kind")
        given = call.get("rawInput") if isinstance(call.get("rawInput"), dict) else {}
        output = call.get("output")
        output = "" if output is None else str(output)
        failed = call.get("status") == "failed"
        server, _, tool = title.partition("/")
        if not tool:
            server, tool = "", title
        try:
            if kind == "delete" or tool == "delete_file":
                self.emit.deleted(str(given.get("path", "")))
            elif tool == "write_text_file" or kind == "edit":
                path = str(given.get("path", ""))
                if tool == "edit_file":
                    diff = lines_of(str(given.get("old_string", "")), "-") + \
                        lines_of(str(given.get("new_string", "")), "+")
                    self.emit.edited(path, diff)
                elif tool == "write_text_file":
                    self.emit.wrote(path, lines_of(str(given.get("content", "")), "+"))
                else:
                    self.emit.used(tool, json.dumps(given), output)
            elif kind == "execute" or tool == "Shell":
                ran = given.get("command")
                if isinstance(ran, str) and ran:
                    text, code = output, 1 if failed else 0
                    ending = EXIT_CODE.search(text)
                    if ending:
                        text, code = text[:ending.start()], int(ending.group(1))
                    self.emit.ran(ran, stdout=text, exit_code=code)
                else:
                    self.emit.used(tool, json.dumps(given), output)
            elif server in ("environment", "local"):
                # fast-agent's own workspace tools, not a server the request named
                self.emit.used(tool, json.dumps(given), output)
            elif server:
                self.emit.called(server, tool, given, output=None if failed else output,
                                 error=output if failed else None)
            else:
                self.emit.used(tool, json.dumps(given), output)
        except Exception as error:  # a malformed line must not end a turn that is otherwise fine
            self.emit.log(f"could not report tool call {title!r}: {error}")

    def end(self, result):
        self.ended = True
        self.finish_tools()
        counted = status_usage((result or {}).get("_meta"))
        if counted:
            self.usage = counted
        reason = (result or {}).get("stopReason") or "end_turn"
        if reason == "end_turn":
            self.emit.done(self.usage)
        elif reason == "max_tokens":
            self.emit.incomplete("max_output_tokens", self.usage)
        elif reason == "refusal" and not self.text and not self.calls:
            self.emit.failed("no_answer", "fast-agent refused the request without producing an answer.")
        elif reason == "refusal":
            self.emit.done(self.usage)
        elif reason == "max_turn_requests":
            self.emit.failed("max_turns", "fast-agent stopped after reaching its own turn limit.")
        elif reason == "cancelled":
            self.emit.failed("cancelled", "fast-agent cancelled the turn.")
        else:
            self.emit.done(self.usage)


def answer_client_request(acp, message, terminals):
    """Answer a request the agent makes of its client: its shell runs here, through terminal/*."""
    method = message.get("method", "")
    params = message.get("params") or {}
    identifier = message.get("id")

    def reply(result):
        acp.send({"jsonrpc": "2.0", "id": identifier, "result": result})

    if method == "terminal/create":
        reply({"terminalId": terminals.create(params)})
    elif method == "terminal/wait_for_exit":
        reply(terminals.wait(params.get("terminalId", "")))
    elif method == "terminal/output":
        reply(terminals.output(params.get("terminalId", "")))
    elif method == "terminal/kill":
        terminals.kill(params.get("terminalId", ""))
        reply(None)
    elif method == "terminal/release":
        terminals.release(params.get("terminalId", ""))
        reply(None)
    elif method == "session/request_permission":
        options = params.get("options") or []
        choice = next((option.get("optionId") for option in options if option.get("optionId")),
                      "allow_always")
        reply({"outcome": {"outcome": "selected", "optionId": choice}})
    else:
        acp.send({"jsonrpc": "2.0", "id": identifier,
                  "error": {"code": -32601, "message": f"this client does not offer {method}"}})


def failure_message(error):
    if not isinstance(error, dict):
        return str(error)
    message = str(error.get("message") or "fast-agent returned an error")
    data = error.get("data")
    if isinstance(data, dict):
        details = data.get("details") or data.get("reason")
        if details and str(details) not in message:
            message += f": {details}"
    return message


def turn(request, emit, state, acp, terminals, servers):
    """Speak ACP to fast-agent once. Returns the translator; the terminal line is its business."""
    saved = state.get("session")
    translator = Translator(emit)
    session_id = saved
    resuming = bool(saved)
    session_request = 2      # the id of the request that creates or resumes the session
    prompt_request = None
    prompt = request.brief(instructions=False)

    acp.start()
    acp.send({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
        "protocolVersion": 1,
        "clientCapabilities": {"fs": {"readTextFile": False, "writeTextFile": False},
                               "terminal": True},
        "clientInfo": {"name": "harnessgateway", "version": "1"},
    }})

    for line in acp.lines():
        try:
            message = json.loads(line)
        except ValueError:
            emit.log(line)
            continue
        if not isinstance(message, dict):
            continue
        if message.get("method") == "session/update":
            params = message.get("params") or {}
            translator.update(params.get("update") or {}, params.get("_meta"))
            continue
        if "method" in message and "id" in message:
            if not acp.replay:      # a recording already holds what the answer led to
                threading.Thread(target=answer_client_request,
                                 args=(acp, message, terminals), daemon=True).start()
            continue
        if "id" not in message:
            continue

        identifier = message["id"]
        if "error" in message:
            if identifier == session_request:
                if resuming:
                    emit.log(f"fast-agent could not resume session {saved}: "
                             f"{failure_message(message['error'])}; starting a new one")
                    state.clear("session")
                    resuming, session_id = False, None
                    session_request = 4
                    acp.send({"jsonrpc": "2.0", "id": session_request, "method": "session/new",
                              "params": {"cwd": os.environ["HG_WORK"], "mcpServers": servers}})
                else:
                    translator.ended = True
                    emit.failed("session_error", failure_message(message["error"]))
                    return translator
                continue
            if identifier == prompt_request:
                translator.finish_tools()
                translator.ended = True
                emit.failed("provider_error", failure_message(message["error"]), translator.usage)
                return translator
            translator.ended = True
            emit.failed("cli_error", failure_message(message["error"]))
            return translator

        result = message.get("result") or {}
        if identifier == 1:                                    # initialize
            if resuming:
                acp.send({"jsonrpc": "2.0", "id": session_request, "method": "session/resume",
                          "params": {"sessionId": session_id, "cwd": os.environ["HG_WORK"],
                                     "mcpServers": servers}})
            else:
                acp.send({"jsonrpc": "2.0", "id": session_request, "method": "session/new",
                          "params": {"cwd": os.environ["HG_WORK"], "mcpServers": servers}})
        elif identifier == session_request:                    # session/new or session/resume
            if "sessionId" in result:
                session_id = result["sessionId"]
                state.set("session", session_id)
                emit.log(f"fast-agent session is {session_id}")
            else:
                session_id = state.get("session")
            prompt_request = 3 if session_request == 2 else 5
            translator.active = True
            acp.send({"jsonrpc": "2.0", "id": prompt_request, "method": "session/prompt", "params": {
                "sessionId": session_id, "prompt": [{"type": "text", "text": prompt}],
            }})
        elif identifier == prompt_request:                     # the turn's answer
            translator.end(result)
            return translator
    return translator


def main():
    request, emit, state = hgkit.Request(), hgkit.Emitter(), hgkit.State()
    try:
        config_path, model_spec = write_config(request)
        instructions_path = write_instructions(request)
    except (ValueError, KeyError) as error:
        emit.failed("configuration", str(error))
        return
    acp = Acp(command(model_spec, config_path, instructions_path), dict(os.environ), os.environ["HG_WORK"],
              record=os.environ.get("HGKIT_RECORD"), replay=os.environ.get("HG_REPLAY"))
    terminals = Terminals()

    def stopped(*_):
        terminals.stop_all()
        acp.stop()
        raise Stop

    previous = signal.signal(signal.SIGTERM, stopped)
    try:
        translator = turn(request, emit, state, acp, terminals, mcp_servers(request))
        if not translator.ended:
            emit.failed("cli_exit", f"fast-agent exited without answering (exit code {acp.process.poll() if acp.process else 'unknown'}).")
        acp.stop()
        terminals.stop_all()
    except Stop:
        sys.exit(0)
    finally:
        signal.signal(signal.SIGTERM, previous)


if __name__ == "__main__":
    main()
