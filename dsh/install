#!/bin/sh
# Install DeepSeek Harness (dsh) at a pinned version under $HG_HARNESS/tools, by its makers' method (npm).
set -eu
VERSION=0.2.2-rc.4

for need in node npm python3; do
  command -v "$need" >/dev/null 2>&1 || {
    echo "this image has no $need: DeepSeek Harness needs Node.js 24.9 or later, and this package's run needs python3" >&2
    exit 1
  }
done
node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 24 || (a === 24 && b >= 9) ? 0 : 1)' || {
  echo "this image's Node.js is $(node --version), and DeepSeek Harness needs 24.9 or later" >&2
  exit 1
}

# No package in this tree is documented as needing an install script; npm 12 runs none unless told to, and
# earlier npm runs every one. Pinning --ignore-scripts makes both the same.
npm install --prefix "$HG_HARNESS/tools" --no-audit --no-fund --loglevel=error --ignore-scripts \
  "@deepseek-ai/dsh@$VERSION"

got=$("$HG_HARNESS/tools/node_modules/.bin/dsh" --version)
[ "$got" = "$VERSION" ] || { echo "installed dsh $got, wanted $VERSION" >&2; exit 1; }
echo "DeepSeek Harness $got installed"
